@model IEnumerable<WebQuanLyDuAn.Models.ProjectTask>
@using WebQuanLyDuAn.Models
@{
    ViewData["Title"] = "Danh sách công việc";
    var projects   = ViewBag.Projects as List<Project> ?? new();
    int? projectId = ViewBag.ProjectId as int?;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-list-check me-2 text-primary"></i>Công việc</h4>
    <a asp-action="Add" asp-route-projectId="@projectId" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Thêm công việc
    </a>
</div>

<!-- Filter bar -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 px-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted small fw-semibold me-1">Lọc theo dự án:</span>
            <a asp-action="Index" class="btn btn-sm @(projectId == null ? "btn-primary" : "btn-outline-secondary")">
                Tất cả
            </a>
            @foreach (var p in projects)
            {
                <a asp-action="Index" asp-route-projectId="@p.Id"
                   class="btn btn-sm @(projectId == p.Id ? "btn-primary" : "btn-outline-secondary")">
                    @p.Name
                </a>
            }
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-3">Chưa có công việc nào. <a asp-action="Add">Thêm ngay!</a></p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tiêu đề</th>
                        <th>Dự án</th>
                        <th>Người được giao</th>
                        <th>Hạn hoàn thành</th>
                        <th>Trạng thái</th>
                        <th>Ưu tiên</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        var project  = projects.FirstOrDefault(p => p.Id == t.ProjectId);
                        var isOverdue = t.DueDate.HasValue
                                        && t.DueDate.Value < DateTime.Today
                                        && t.Status != WorkStatus.HoanThanh;
                        <tr class="@(isOverdue ? "table-danger-soft" : "")">
                            <td>
                                <a asp-action="Display" asp-route-id="@t.Id"
                                   class="fw-semibold text-decoration-none text-dark">
                                    @t.Title
                                </a>
                            </td>
                            <td>
                                @if (project != null)
                                {
                                    <a asp-controller="Project" asp-action="Display" asp-route-id="@project.Id"
                                       class="text-decoration-none small">@project.Name</a>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td>@(t.AssignedTo ?? "—")</td>
                            <td class="@(isOverdue ? "text-danger fw-semibold" : "")">
                                @(t.DueDate?.ToString("dd/MM/yyyy") ?? "—")
                                @if (isOverdue) { <i class="bi bi-exclamation-circle ms-1"></i> }
                            </td>
                            <td>@Html.Raw(WorkStatusBadge(t.Status))</td>
                            <td>@Html.Raw(PriorityBadge(t.Priority))</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Display" asp-route-id="@t.Id"
                                       class="btn btn-outline-secondary" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Update" asp-route-id="@t.Id"
                                       class="btn btn-outline-primary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@t.Id"
                                       class="btn btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@functions {
    string WorkStatusBadge(WorkStatus s) => s switch
    {
        WorkStatus.DangLam   => "<span class='badge bg-primary'>Đang làm</span>",
        WorkStatus.HoanThanh => "<span class='badge bg-success'>Hoàn thành</span>",
        WorkStatus.BiChan    => "<span class='badge bg-danger'>Bị chặn</span>",
        _                    => "<span class='badge bg-light text-dark border'>Cần làm</span>"
    };

    string PriorityBadge(PriorityLevel p) => p switch
    {
        PriorityLevel.KhanCap   => "<span class='badge bg-danger'>Khẩn cấp</span>",
        PriorityLevel.Cao       => "<span class='badge bg-orange text-white'>Cao</span>",
        PriorityLevel.TrungBinh => "<span class='badge bg-info text-dark'>Trung bình</span>",
        _                       => "<span class='badge bg-light text-dark border'>Thấp</span>"
    };
}
