@model WebQuanLyDuAn.Models.ProjectTask
@{
    ViewData["Title"] = "Xác nhận xóa";
    var project = ViewBag.Project as WebQuanLyDuAn.Models.Project;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa công việc</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-muted">Bạn có chắc chắn muốn xóa công việc này không?</p>

                <table class="table table-sm table-borderless">
                    <tr>
                        <td class="text-muted fw-semibold" width="150">Tiêu đề</td>
                        <td class="fw-bold">@Model.Title</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Dự án</td>
                        <td>@(project?.Name ?? "—")</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Người được giao</td>
                        <td>@(Model.AssignedTo ?? "—")</td>
                    </tr>
                </table>

                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i>Xóa công việc
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i>Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
