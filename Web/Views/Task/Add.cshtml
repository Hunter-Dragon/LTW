@model WebQuanLyDuAn.Models.ProjectTask
@{
    ViewData["Title"] = "Thêm công việc mới";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="bi bi-plus-square me-2"></i>Thêm công việc mới</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Add" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề công việc..." />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Mô tả chi tiết công việc..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProjectId" class="form-label fw-semibold">Dự án</label>
                        <select asp-for="ProjectId" asp-items="ViewBag.ProjectList" class="form-select">
                            <option value="">-- Chọn dự án --</option>
                        </select>
                        <span asp-validation-for="ProjectId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                            <input asp-for="AssignedTo" class="form-control" placeholder="Tên người thực hiện..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DueDate" class="form-label fw-semibold"></label>
                            <input asp-for="DueDate" class="form-control" type="date" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" asp-items="ViewBag.StatusList" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold"></label>
                            <select asp-for="Priority" asp-items="ViewBag.PriorityList" class="form-select"></select>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Lưu công việc
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
